<!-- Responsive Sidebar Wrapper -->
<div
  class="md:w-64 w-full bg-white text-slate-800 shadow-xl border-b md:border-b-0 md:border-r border-slate-200 flex md:flex-col flex-row justify-between md:justify-start items-center p-4 md:p-6"
>
  <!-- Logo & Toggle -->
  <div
    class="flex md:flex-col items-center w-full justify-between md:justify-center"
  >
    <!-- Institute Logo -->
    <div class="md:mb-6">
      <a href="/">
        <img
          src="<%= headerImageUrl %>"
          alt="Institute Logo"
          class="w-50 h-auto rounded-xl shadow-md border border-slate-200"
        />
      </a>
    </div>

    <!-- Mobile Toggle Button (optional for real collapse logic) -->
    <div class="md:hidden">
      <!-- You can add JS later for actual collapse -->
    </div>
  </div>

  <!-- Sidebar Title (Only on Desktop) -->
  <h2
    class="hidden md:block text-lg font-semibold text-center text-blue-700 mb-4 mt-4 border-b border-slate-200 pb-2"
  >
    👩‍🎓 Student Panel
  </h2>

  <!-- Navigation -->
  <nav
    class="flex md:flex-col flex-row md:space-y-2 space-x-2 md:space-x-0 text-sm font-medium w-full mt-4 md:mt-0"
  >
    <a
      href="/student/dashboard"
      class="flex-1 md:flex-none px-3 py-2 rounded-lg transition-colors duration-200 flex items-center gap-2 justify-center md:justify-start <%= currentPath === '/student/dashboard' ? 'bg-blue-100 text-blue-700 font-semibold' : 'hover:bg-blue-50 hover:text-blue-700' %>"
    >
      📊 <span class="hidden md:inline">Dashboard</span>
    </a>

    <a
      href="/student/profile"
      class="flex-1 md:flex-none px-3 py-2 rounded-lg transition-colors duration-200 flex items-center gap-2 justify-center md:justify-start <%= currentPath === '/student/profile' ? 'bg-blue-100 text-blue-700 font-semibold' : 'hover:bg-blue-50 hover:text-blue-700' %>"
    >
      👤 <span class="hidden md:inline">My Profile</span>
    </a>

    <a
      href="/student/courses"
      class="flex-1 md:flex-none px-3 py-2 rounded-lg transition-colors duration-200 flex items-center gap-2 justify-center md:justify-start <%= currentPath === '/student/courses' ? 'bg-blue-100 text-blue-700 font-semibold' : 'hover:bg-blue-50 hover:text-blue-700' %>"
    >
      📚 <span class="hidden md:inline">My Courses</span>
    </a>

    <a
      href="/student/payments"
      class="flex-1 md:flex-none px-3 py-2 rounded-lg transition-colors duration-200 flex items-center gap-2 justify-center md:justify-start <%= currentPath === '/student/payments' ? 'bg-blue-100 text-blue-700 font-semibold' : 'hover:bg-blue-50 hover:text-blue-700' %>"
    >
      💳 <span class="hidden md:inline">Payment History</span>
    </a>
  </nav>

  <!-- Logout -->
  <a
    href="/student/logout"
    class="mt-4 md:mt-6 w-full text-center bg-red-100 text-red-700 hover:bg-red-200 transition-colors px-3 py-2 rounded-lg font-semibold"
  >
    🚪 Logout
  </a>
</div>
