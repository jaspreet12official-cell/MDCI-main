<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Desinerz Academy - Home</title>
    <meta name="description" content="" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta http-equiv="x-ua-compatible" content="IE=10" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0//css/font-awesome.min.css"
    />
    <link href="/css/fonts/fonts.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/custom.css" />
    <script type="text/javascript" src="/js/jquery.min.js"></script>
    <script type="text/javascript" src="/js/bootstrap.bundle.min.js"></script>
    <!-- page animation section css start -->
    <link rel="stylesheet" href="/css/animation.css" />
    <link rel="stylesheet" href="/css/aos.css" />
    <link rel="stylesheet" href="/css/w3.css" />
    <!-- page animation section css end -->
    <!-- cursor animated -->
    <link
      rel="stylesheet"
      type="text/css"
      media="screen"
      href="/css/cursor.css"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2//css/all.css"
    />
    <!-- cursor animated -->

    <!-- slick -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/swiper@8/swiper-bundle.min.css"
    />

    <script src="https://unpkg.com/swiper@8/swiper-bundle.min.js"></script>
    <!-- slick -->
  </head>

  <body id="body">
    <%- include("partials/header") %>
    <div class="page-wrapper" id="dashboard-page">
      <!-- main content -->
      <div class="main-wrapper">
        <div class="content-wrapper">
          <section class="bg_banner">
            <div class="container">
              <div class="bg_banner-text text-center">
                <p class="text-white">Chalo! Apna Career Bnaaye.</p>
                <h1 class="text-white">
                  Over 12,000+ students enrolled in the year of 2024-25
                </h1>
                <section class="is_breadcrumb">
                  <div class="container">
                    <ul
                      class="p-0 m-0 position-relative d-flex align-items-center justify-content-center"
                    >
                      <li>
                        <a href="/"
                          ><i
                            class="fa fa-home home_icon"
                            aria-hidden="true"
                          ></i>
                          Home</a
                        >
                      </li>

                      <?xml version="1.0" encoding="utf-8"?>
                      <!-- Uploaded to: SVG Repo, www.svgrepo.com, Generator: SVG Repo Mixer Tools -->
                      <svg
                        width="10px"
                        height="10px"
                        viewBox="0 0 1024 1024"
                        class="icon"
                        version="1.1"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M256 120.768L306.432 64 768 512l-461.568 448L256 903.232 659.072 512z"
                          fill="#fff"
                        />
                      </svg>
                      <li class="active">Contact Us</li>
                    </ul>
                  </div>
                </section>
              </div>
            </div>
          </section>
          <section class="contact_info section_space">
            <div class="container">
              <div class="contact-component">
                <div class="section_heading is_para">
                  <%- topContactSection %>
                </div>
                <div class="row mt-4">
                  <% contactSections.forEach(section => { %>
                  <div class="col-md-4">
                    <div class="contact_block">
                      <div class="contact_top">
                        <!-- Contact Image -->
                        <div class="contact_icon text-center mb-3">
                          <img
                            src="<%= section.imagePath %>"
                            alt="<%= section.name %> image"
                            class="img-fluid"
                            style="width: 100px; height: auto"
                          />
                        </div>

                        <!-- Icon Based on Name -->
                        <% if (section.name.toLowerCase().includes('phone')) {
                        %>
                        <!-- Phone Icon -->
                        <!-- (Optional: you can keep/remove icons here) -->
                        <% } else if
                        (section.name.toLowerCase().includes('email')) { %>
                        <!-- Email Icon -->
                        <% } else { %>
                        <!-- Address Icon -->
                        <% } %>

                        <h4 class="text-center"><%= section.heading %></h4>
                      </div>

                      <p class="text-black text-center">
                        <% if (section.name.toLowerCase().includes('phone')) {
                        %> <%= section.content .split('|') .map(p => `<a
                          href="tel:${p.trim()}"
                          class="text-black"
                          >${p.trim()}</a
                        >`) .join(' | ') %> <% } else if
                        (section.name.toLowerCase().includes('email')) { %>
                        <a
                          class="text-black text-lowercase"
                          href="mailto:<%= section.content.trim() %>"
                        >
                          <%= section.content.trim() %>
                        </a>
                        <% } else { %> <%= section.content %> <% } %>
                      </p>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </section>

          <section class="map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d13972.951162051604!2d76.5977105!3d28.8912811!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390d8531e1920db9%3A0xa303acea57b7f227!2sMDC%20Maharishi%20Dayanand%20College%20Best%20Ui%2FUx%20%26%20Graphics%20Design%2C%20Digital%20Marketing%2C%20Computer%20Basics%20%26Typing%20Institute%20in%20Rohtak!5e0!3m2!1sen!2sin!4v1720422430994!5m2!1sen!2sin"
              width="100%"
              height="450"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </section>
        </div>
      </div>
    </div>

    <!-- main content -->

    <!-- footer section -->
    <%- include("partials/footer") %>

    <!-- slick -->

    <!-- slick -->

    <script>
      const swiper = new Swiper(".swiper", {
        // Optional parameters
        loop: true,
        centeredSlides: true,
        // Navigation arrows
        //   navigation: {
        //     nextEl: '.swiper-button-next',
        //     prevEl: '.swiper-button-prev',
        //   },
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        breakpoints: {
          // when window width is >= 320px
          768: {
            slidesPerView: 3,
            spaceBetween: 30,
          },
          // when window width is >= 480px
          1024: {
            slidesPerView: 3,
            spaceBetween: 40,
          },
          // when window width is >= 640px
          1280: {
            slidesPerView: 3,
            spaceBetween: 74,
          },
        },
      });
    </script>
    <script>
      var swiper2 = new Swiper(".swiper-container", {
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        parallax: true,
        speed: 600,
        breakpoints: {
          // when window width is >= 320px
          768: {
            slidesPerView: 1.1,
            spaceBetween: 16,
          },
          // when window width is >= 480px
          1024: {
            slidesPerView: 2,
            spaceBetween: 40,
          },
          // when window width is >= 640px
          1280: {
            slidesPerView: 2,
            spaceBetween: 29,
          },
        },
      });
    </script>

    <script type="text/javascript" src="/js/custom.js"></script>
    <script src="/js/cursor.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13//js/intlTelInput-jquery.min.js"></script>
    <script type="text/javascript" src="/js/custom.js"></script>
    <!-- page animation section js start -->
    <script type="text/javascript" src="/js/animation.js"></script>

    <!-- page animation section js end -->
  </body>
</html>
