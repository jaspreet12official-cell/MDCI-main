                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
          <section class="testimonials section_space">
            <div class="container">
              <div class="testimonial_component">
                <div class="section_heading is_para">
                  <p class="text-blue">Students Reviews</p>
                  <h3>What our <span class="text-blue">Student</span> Says</h3>
                  <p class="para">
                    Real success stories from our academy graduates. Gain real
                    skills and effective <br />implementation in the field.
                    Connect with us today!
                  </p>
                </div>
              </div>

              <div class="testimonial_wrap">
                <div class="slick-slider">
                  <% reviews.forEach(function(review) { %>
                  <div class="element element-1">
                    <div class="testimonial_item">
                      <div class="row">
                        <div class="col-md-5">
                          <div class="testimonial_left">
                            <div class="testimonial_im-wrapper">
                              <img
                                src="<%= review.imagePath %>"
                                alt="<%= review.name %>"
                              />
                            </div>
                            <div class="testimonial_user-info">
                              <h5 class="text-blue"><%= review.name %></h5>
                              <p class="position"><%= review.position %></p>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-7">
                          <div class="testimonial_slidecontent">
                            <div
                              class="rating_star-grp d-flex align-items-center"
                            >
                              <% for (let i = 0; i < 5; i++) { %>
                              <svg
                                width="42"
