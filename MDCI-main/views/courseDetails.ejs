                                viewBox="0 0 42 41"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path
                                  d="M19.3579 4.41929C19.7933 3.07901 21.6895 3.07901 22.125 4.41929L24.9874 13.2289C25.1822 13.8283 25.7407 14.2341 26.371 14.2341L35.634 14.2341C37.0432 14.2341 37.6292 16.0375 36.489 16.8658L28.9951 22.3105C28.4852 22.6809 28.2719 23.3376 28.4666 23.937L31.3291 32.7466C31.7646 34.0869 30.2305 35.2014 29.0904 34.3731L21.5965 28.9284C21.0866 28.558 20.3962 28.558 19.8863 28.9284L12.3924 34.3731C11.2523 35.2014 9.71827 34.0869 10.1538 32.7466L13.0162 23.937C13.2109 23.3376 12.9976 22.6809 12.4877 22.3105L4.99378 16.8658C3.85366 16.0375 4.4396 14.2341 5.84887 14.2341L15.1119 14.2341C15.7421 14.2341 16.3007 13.8283 16.4954 13.2289L19.3579 4.41929Z"
                                  fill="#FED917"
                                />
                              </svg>
                              <% } %>
                            </div>
