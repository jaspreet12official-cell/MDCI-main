        <section class="programs is_home section_space">
          <div class="container">
            <div class="program_component">
              <div class="section_heading is_para">
                <p class="text-blue">Course</p>
                <h3>Suggested Course</h3>
              </div>
              <div class="home_program-content">
                <!-- Design Courses Tab Pane -->
                <div
                  class="tab-pane fade show active"
                  id="design"
                  role="tabpanel"
                  aria-labelledby="design-tab"
                >
                  <div class="home_program-content">
                    <div class="row">
                      <% if (groupedCourses["Design Courses"]) { %> <%
                      groupedCourses["Design Courses"].forEach(course => { %>
                      <div class="col-md-6 col-lg-4">
                        <div class="program_item">
                          <div class="program_im-wrapper">
                            <img
                              src="<%= course.courseImage %>"
                              class="w-100 h-100"
                            />
                          </div>
                          <div class="program_content">
                            <div class="course_heading">
                              <p class="program_category text-blue">
                                <%= course.category %>
                              </p>
                              <h4 class="course_heading"><%= course.name %></h4>
                            </div>
