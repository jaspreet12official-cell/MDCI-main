                              <div class="faq_icon position-relative">
                                <div class="plus">
                                  <svg
                                    width="17"
                                    height="14"
                                    viewBox="0 0 17 14"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                  >
                                    <path
                                      d="M8.16064 1.41406V13.1053"
                                      stroke="#303A42"
                                      stroke-width="1.69884"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                    <path
                                      d="M1.0249 7.25977H15.2971"
