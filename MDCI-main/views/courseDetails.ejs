                                      d="M1.30957 1.01367H15.5818"
                                      stroke="#7F56D9"
                                      stroke-width="1.69884"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>
                                </div>
                              </div>
