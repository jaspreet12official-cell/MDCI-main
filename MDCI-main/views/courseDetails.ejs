  <body id="body">
    <%- include("partials/header") %>
    <div class="page-wrapper" id="dashboard-page">
      <!-- main content -->
      <div class="main-wrapper">
        <div class="content-wrapper">
          <section class="bg_banner">
            <div class="container">
              <div class="bg_banner-text text-center">
                <p class="text-white">Chalo! Apna Career Bnaaye.</p>
                <h1 class="text-white">
                  Over 12,000+ students enrolled in the year of 2023-24
                </h1>
                <section class="is_breadcrumb">
                  <div class="container">
                    <ul
                      class="p-0 m-0 position-relative d-flex align-items-center justify-content-center"
                    >
                      <li>
                        <a href="/"
                          ><i
                            class="fa fa-home home_icon"
                            aria-hidden="true"
                          ></i>
                          Home</a
                        >
                      </li>

                      <?xml version="1.0" encoding="utf-8"?>
                      <!-- Uploaded to: SVG Repo, www.svgrepo.com, Generator: SVG Repo Mixer Tools -->
                      <svg
                        width="10px"
                        height="10px"
                        viewBox="0 0 1024 1024"
                        class="icon"
                        version="1.1"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M256 120.768L306.432 64 768 512l-461.568 448L256 903.232 659.072 512z"
                          fill="#fff"
                        />
                      </svg>
                      <li class="active">Our Courses</li>
                      <svg
                        width="10px"
                        height="10px"
                        viewBox="0 0 1024 1024"
                        class="icon"
                        version="1.1"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M256 120.768L306.432 64 768 512l-461.568 448L256 903.232 659.072 512z"
                          fill="#fff"
                        />
                      </svg>
                      <li class="active">Course Detail</li>
                    </ul>
                  </div>
                </section>
              </div>
            </div>
          </section>
          <section class="clg_detail-hero">
            <div class="container">
              <div class="clg_detail-wrap">
                <div class="row">
                  <div class="col-md-8">
                    <div class="clg_detail-hero-wrap">
                      <div class="clg_detail-hero-top">
                        <h1><%= course.name %></h1>
                        <div class="program_rating">
                          <div class="program_rating-left">
                            <p class="text-blue"><%= course.rating %></p>

                            <!-- You can create a partial to dynamically render SVG stars if you want, or render based on rating -->
                            <!-- Static SVG stars here -->
                            <%- include("partials/star-svg") %>
                          </div>
                        </div>
                        <p>
                          Ranked Among the Top Universities of India in Over 20
                          Prestigious Researches &amp; Rankings. Ranked among
                          "Top Six Promising Universities of The Country" by
                          India Today. Explore More!
                        </p>
                      </div>

                      <a
                        href="<%= course.pdfLink %>"
                        class="btn_pdf w-50"
                        download
                      >
                        Download PDF
                        <svg
                          width="17"
                          height="18"
                          viewBox="0 0 17 18"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M8.19895 1.92893V16.0711M8.19895 16.0711L15.27 9M8.19895 16.0711L1.12788 9"
                            stroke="#FF2626"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <div class="clg_detail-hero-im-wrapper position-relative">
                      <img
                        src="<%= course.courseImage %>"
                        class="w-100 h-100"
                        alt="<%= course.name %>"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="section_topic section_space">
            <div class="container">
              <div class="topic-component">
                <div class="section_heading is_para">
                  <h3 class="text-left">Topic Covered</h3>
                </div>
                <div class="row">
                  <% if (course.topics && course.topics.length > 0) { %> <%
                  course.topics.forEach(topic => { %>
                  <div class="col-md-3">
                    <div class="topic_item">
                      <p class="hours text-blue"><%= topic.duration %></p>
                      <h6><%= topic.name %></h6>
                    </div>
                  </div>
                  <% }) %> <% } else { %>
                  <p class="text-muted">No topics available for this course.</p>
                  <% } %>
                </div>
              </div>
            </div>
          </section>

          <section class="faq section_space">
            <div class="container">
              <div class="faq_component">
                <div class="section_heading is_para">
                  <p class="text-blue">FAQ</p>
                  <h3>How We Can Help You?</h3>
                </div>
                <div class="row align-items-center justify-content-center">
                  <div class="col-md-12 col-lg-8">
                    <div id="accordion" class="faq_accordian is_left">
                      <div class="card">
                        <div class="card-header" id="headingOne">
                          <h5 class="mb-0">
                            <button
                              class="btn btn-link"
                              data-toggle="collapse"
                              data-target="#collapseOne"
                              aria-expanded="true"
                              aria-controls="collapseOne"
                            >
                              What is the duration of the Graphics Design
                              course?
