                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>
                                </div>
                                <div class="minus">
                                  <svg
                                    width="17"
                                    height="2"
                                    viewBox="0 0 17 2"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                  >
                                    <path
                                      d="M1.30957 1.01367H15.5818"
                                      stroke="#7F56D9"
                                      stroke-width="1.69884"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>
                                </div>
                              </div>
                            </button>
                          </h5>
