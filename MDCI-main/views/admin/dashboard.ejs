<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
    <!-- Use filled icon set (if you want ph-fill) -->
    <!-- Font Awesome 6 Free -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      integrity="sha512-Fo3rlrZj/k7ujTnHg4C+XqgIq6rQd9v/z3D0h+OAEUDFClBzQz+3iZvmX3h8NIRbC9+/i5U3swVeZVjcbG84JQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script src="/assets/js/phosphor-icon.js"></script>

    <!-- Dashboard-body styles only (scoped with dx- prefix) -->
    <style>
      .dashboard-body.dx-dashboard {
        background: #f7f8fb;
        overflow-x: hidden;
      }
      .dx-dashboard *,
      .dx-dashboard *::before,
      .dx-dashboard *::after {
        box-sizing: border-box;
      }

      /* ---------- Grids ---------- */
      .dx-grid {
        display: grid;
        gap: 20px;
        margin-bottom: 20px;
      }
      .dx-grid > * {
        min-width: 0;
      }
      .dx-grid-stats {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
      .dx-grid-main {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      }
      .dx-grid-bottom {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      }
      @media (max-width: 1199.98px) {
        .dx-grid-stats {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (max-width: 991.98px) {
        .dx-grid-main,
        .dx-grid-bottom {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      @media (max-width: 575.98px) {
        .dx-grid-stats {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- Cards ---------- */
      .dx-card {
        position: relative;
        background: #fff;
        border: 1px solid #eceef4;
        border-radius: 16px;
        box-shadow: 0 1px 3px rgba(17, 24, 39, 0.05);
        padding: 22px 24px;
        overflow: hidden;
      }
      .dx-accent {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
      }
      .dx-stat-top {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .dx-stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f1edff;
        color: #6d4aff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
      }
      .dx-trend {
        color: #16a34a;
        font-size: 13px;
        font-weight: 500;
      }
      .dx-stat-count {
        font-size: 32px;
        font-weight: 700;
        color: #111827;
        line-height: 1;
      }
      .dx-stat-label {
        color: #8b93a3;
        font-size: 14px;
        margin-top: 16px;
      }

      /* ---------- Card headings ---------- */
      .dx-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
      }
      .dx-title {
        font-size: 17px;
        font-weight: 600;
        color: #111827;
        margin: 0;
      }
      .dx-pill {
        background: #f1edff;
        color: #6d4aff;
        font-size: 12px;
        font-weight: 500;
        padding: 4px 12px;
        border-radius: 999px;
        white-space: nowrap;
      }

      /* ---------- Charts ---------- */
      .dx-chart {
        width: 100%;
        min-height: 280px;
      }
      .dx-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 200px;
        padding: 20px;
        color: #9aa1b0;
        font-size: 14px;
        border: 1px dashed #e4e7ef;
        border-radius: 12px;
        background: #fafbfd;
      }

      /* ---------- Courses by category ---------- */
      .dx-bar-row {
        margin-bottom: 18px;
      }
      .dx-bar-row:last-child {
        margin-bottom: 0;
      }
      .dx-bar-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 14px;
        color: #374151;
        margin-bottom: 8px;
      }
      .dx-bar-head b {
        color: #111827;
        font-weight: 600;
      }
      .dx-bar-pct {
        color: #6d4aff;
        font-weight: 500;
        font-size: 13px;
      }
      .dx-bar-track {
        height: 8px;
        background: #f0f1f6;
        border-radius: 999px;
        overflow: hidden;
      }
      .dx-bar-fill {
        height: 100%;
        width: 0;
        border-radius: 999px;
        background: linear-gradient(90deg, #6d4aff, #9b7bff);
        transition: width 0.6s ease;
      }

      /* ---------- Recent activity ---------- */
      .dx-activity {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 0;
        border-bottom: 1px solid #f0f1f6;
      }
      .dx-activity:first-of-type {
        padding-top: 0;
      }
      .dx-activity:last-child {
        border-bottom: 0;
        padding-bottom: 0;
      }
      .dx-avatar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 50%;
        color: #fff;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .dx-av-0 { background: #6d4aff; }
      .dx-av-1 { background: #8b5cf6; }
      .dx-av-2 { background: #0ea5e9; }
      .dx-av-3 { background: #f59e0b; }
      .dx-activity-body {
        min-width: 0;
      }
      .dx-activity-body p {
        margin: 0;
        font-size: 14px;
        color: #1f2937;
        word-break: break-word;
      }
      .dx-activity-body small {
        color: #9aa1b0;
        font-size: 13px;
      }
    </style>
  </head>
  <body>
