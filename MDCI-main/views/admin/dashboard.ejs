    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const dropdownToggles = document.querySelectorAll(
          ".sidebar-menu__item.has-dropdown > a"
        );

        dropdownToggles.forEach(function (toggle) {
          toggle.addEventListener("click", function (e) {
            e.preventDefault(); // prevent default anchor behavior
            const parentLi = this.closest(".sidebar-menu__item");
            parentLi.classList.toggle("open");
          });
        });
      });
    </script>

    <!-- ============================ Sidebar End  ============================ -->

    <div class="dashboard-main-wrapper">
      <div
        class="top-navbar flex-between gap-16"
        style="background-color: white"
      >
        <div class="flex-align gap-16">
          <!-- Toggle Button Start -->
          <button
            type="button"
            class="toggle-btn d-xl-none d-flex text-26 text-gray-500"
          >
            <i class="ph ph-list"></i>
          </button>
          <!-- Toggle Button End -->

          <h1>DashBoard</h1>
        </div>

        <div class="flex-align gap-16">
          <a
            href="/admin/logout"
            class="py-12 text-15 px-20 hover-bg-danger-50 text-gray-300 hover-text-danger-600 rounded-8 flex-align gap-8 fw-medium text-15"
          >
            <span class="text-2xl text-danger-600 d-flex"
              ><i class="ph ph-sign-out"></i
            ></span>
            <span class="text">Log Out</span>
          </a>
          <!-- User Profile Start -->
        </div>
      </div>

      <%
        /*
          OPTIONAL data. These are read only if your controller passes them.
          Nothing is invented: if a variable is missing, that section shows
          an empty state instead of fake numbers.

          categories      : [{ name, count }]
          activities      : [{ name, text, link, time }]
          enrollmentTrend : { name, labels: [], data: [] }
        */
        var dxCats = (typeof categories !== "undefined" && Array.isArray(categories)) ? categories : [];
        var dxCatTotal = dxCats.reduce(function (s, c) { return s + Number(c.count || 0); }, 0);

        var dxActs = (typeof activities !== "undefined" && Array.isArray(activities)) ? activities : [];

        var dxTrend = (typeof enrollmentTrend !== "undefined" && enrollmentTrend && Array.isArray(enrollmentTrend.labels) && Array.isArray(enrollmentTrend.data) && enrollmentTrend.labels.length) ? enrollmentTrend : null;

        // Only show these 4 cards: students, courses, enrollment, get in touch
        var dxStats = stats.filter(function (s) { return /student|course|enroll|touch/i.test(String(s.label)); }).slice(0, 4);

        // Donut chart uses the same filtered stats (real data already on the page)
        var dxOverview = dxStats.filter(function (s) { return Number(s.count) > 0; });
        var dxOverviewTotal = dxOverview.reduce(function (t, s) { return t + Number(s.count); }, 0);
      %>

      <!-- ============================ Dashboard Body ============================ -->
      <div class="dashboard-body dx-dashboard">
        <!-- ========== SECTION 1: Stat cards (dynamic from stats) ========== -->
        <div class="dx-grid dx-grid-stats">
          <% dxStats.forEach((item) => { %>
          <div class="dx-card">
            <span class="dx-accent <%= item.color %>"></span>
            <div class="dx-stat-top">
              <span class="dx-stat-icon">
                <i class="fa-solid <%= item.icon %>"></i>
              </span>
              <div class="dx-stat-count"><%= item.count %></div>
            </div>
            <div class="dx-stat-label"><%= item.label %></div>
          </div>
          <% }); %>
        </div>

        <!-- ========== SECTION 2: Analytics ========== -->
        <div class="dx-grid dx-grid-main">
          <div class="dx-card">
            <div class="dx-head">
              <h5 class="dx-title">Overview Trend</h5>
              <% if (dxTrend) { %>
              <span class="dx-pill"><%= dxTrend.name || "Trend" %></span>
              <% } %>
            </div>
            <% if (dxTrend) { %>
            <div
              id="dx-trend-chart"
              class="dx-chart"
              data-name="<%= dxTrend.name || 'Trend' %>"
              data-labels="<%= JSON.stringify(dxTrend.labels) %>"
              data-values="<%= JSON.stringify(dxTrend.data) %>"
            ></div>
            <% } else { %>
            <div class="dx-empty">
              Trend data is not available yet. Pass "enrollmentTrend" from the
              controller to show the chart.
            </div>
            <% } %>
          </div>

          <div class="dx-card">
            <div class="dx-head">
              <h5 class="dx-title">Overview</h5>
              <span class="dx-pill"><%= dxOverviewTotal %> total</span>
            </div>
            <% if (dxOverview.length) { %>
            <div
              id="dx-donut-chart"
              class="dx-chart"
              data-labels="<%= JSON.stringify(dxOverview.map(function (s) { return s.label; })) %>"
              data-values="<%= JSON.stringify(dxOverview.map(function (s) { return Number(s.count); })) %>"
            ></div>
            <% } else { %>
            <div class="dx-empty">No data to display yet.</div>
            <% } %>
          </div>
        </div>

        <!-- ========== SECTION 3 + 4: Courses by category / Recent activity ========== -->
        <div class="dx-grid dx-grid-bottom">
          <div class="dx-card">
            <div class="dx-head">
              <h5 class="dx-title">Courses by Category</h5>
              <% if (dxCats.length) { %>
              <span class="dx-pill"><%= dxCatTotal %> total</span>
              <% } %>
            </div>

            <% if (dxCats.length) { %> <% dxCats.forEach((c) => { var dxPct = dxCatTotal ? Math.round((Number(c.count || 0) / dxCatTotal) * 100) : 0; %>
            <div class="dx-bar-row">
              <div class="dx-bar-head">
                <span><%= c.name %></span>
                <b><%= c.count %> <span class="dx-bar-pct">(<%= dxPct %>%)</span></b>
              </div>
              <div class="dx-bar-track">
                <div
                  class="dx-bar-fill"
                  data-count="<%= c.count %>"
                  data-total="<%= dxCatTotal %>"
                ></div>
              </div>
            </div>
            <% }); %> <% } else { %>
            <div class="dx-empty">
              Category data is not available yet. Pass "categories" from the
              controller as [{ name, count }].
            </div>
            <% } %>
          </div>

          <div class="dx-card">
            <div class="dx-head">
              <h5 class="dx-title">Recent Activity</h5>
            </div>

            <% if (dxActs.length) { %> <% dxActs.forEach((a, i) => { %>
            <div class="dx-activity">
              <div class="dx-avatar dx-av-<%= i % 4 %>">
                <%= String(a.name || "?").trim().split(/\s+/).map(function (w) { return w.charAt(0); }).join("").slice(0, 2).toUpperCase() %>
              </div>
              <div class="dx-activity-body">
                <p>
                  <strong><%= a.name %></strong> <%= a.text || "" %>
                  <% if (a.link) { %><span><%= a.link %></span><% } %>
                </p>
                <% if (a.time) { %><small><%= a.time %></small><% } %>
              </div>
            </div>
            <% }); %> <% } else { %>
            <div class="dx-empty">
              No recent activity yet. Pass "activities" from the controller as
              [{ name, text, link, time }].
            </div>
            <% } %>
          </div>
        </div>
      </div>
      <!-- ============================ Dashboard Body End ============================ -->
    </div>

    <!-- Jquery js -->
    <script src="/assets/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap Bundle Js -->
    <script src="/assets/js/boostrap.bundle.min.js"></script>
    <!-- Phosphor Js -->
    <script src="/assets/js/phosphor-icon.js"></script>
    <!-- file upload -->
    <script src="/assets/js/file-upload.js"></script>
    <!-- file upload -->
    <script src="/assets/js/plyr.js"></script>
    <!-- dataTables -->
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <!-- full calendar -->
    <script src="/assets/js/full-calendar.js"></script>
    <!-- jQuery UI -->
    <script src="/assets/js/jquery-ui.js"></script>
    <!-- jQuery UI -->
    <script src="/assets/js/editor-quill.js"></script>
    <!-- apex charts -->
    <script src="/assets/js/apexcharts.min.js"></script>
    <!-- Calendar Js -->
    <script src="/assets/js/calendar.js"></script>
    <!-- jvectormap Js -->
    <script src="/assets/js/jquery-jvectormap-2.0.5.min.js"></script>
    <!-- jvectormap world Js -->
    <script src="/assets/js/jquery-jvectormap-world-mill-en.js"></script>

    <!-- main js -->
    <script src="/assets/js/main.js"></script>

    <!-- Dashboard charts + progress bars (data comes from data-* attributes) -->
    <script>
      (function () {
        function readJSON(value) {
          try {
            return JSON.parse(value);
          } catch (e) {
            return null;
          }
        }

        // Progress bars
        document.querySelectorAll(".dx-bar-fill").forEach(function (el) {
          var count = Number(el.dataset.count) || 0;
          var total = Number(el.dataset.total) || 0;
          el.style.width = (total ? Math.round((count / total) * 100) : 0) + "%";
        });

        if (typeof ApexCharts === "undefined") return;

        var violet = ["#6D4AFF", "#8B5CF6", "#A78BFA", "#0EA5E9", "#F59E0B", "#10B981"];

        // Main trend chart (renders only if real trend data was passed)
        var trendEl = document.getElementById("dx-trend-chart");
        if (trendEl) {
          var tLabels = readJSON(trendEl.dataset.labels) || [];
          var tValues = readJSON(trendEl.dataset.values) || [];
          new ApexCharts(trendEl, {
            series: [{ name: trendEl.dataset.name || "Trend", data: tValues }],
            chart: {
              type: "area",
              height: 300,
              toolbar: { show: false },
              fontFamily: "inherit",
              zoom: { enabled: false },
            },
            colors: ["#6D4AFF"],
            stroke: { curve: "smooth", width: 3 },
            dataLabels: { enabled: false },
            fill: {
              type: "gradient",
              gradient: { opacityFrom: 0.35, opacityTo: 0.02, stops: [0, 100] },
            },
            grid: { borderColor: "#eef0f5", strokeDashArray: 4 },
            xaxis: {
              categories: tLabels,
              axisBorder: { show: false },
              axisTicks: { show: false },
              labels: { style: { colors: "#9aa1b0" } },
            },
            yaxis: { labels: { style: { colors: "#9aa1b0" } } },
            tooltip: { theme: "light" },
          }).render();
        }

        // Overview donut (built from the existing stats array)
        var donutEl = document.getElementById("dx-donut-chart");
        if (donutEl) {
          var dLabels = readJSON(donutEl.dataset.labels) || [];
          var dValues = readJSON(donutEl.dataset.values) || [];
          new ApexCharts(donutEl, {
            series: dValues,
            labels: dLabels,
            chart: { type: "donut", height: 300, fontFamily: "inherit" },
            colors: violet,
            legend: { position: "bottom", fontSize: "13px" },
            dataLabels: { enabled: false },
            stroke: { width: 2, colors: ["#fff"] },
            plotOptions: { pie: { donut: { size: "70%" } } },
          }).render();
        }
      })();
    </script>
  </body>
</html>
