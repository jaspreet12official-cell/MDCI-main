                  >
                </li>
                <li class="sidebar-submenu__item">
                  <a href="/edit-page" class="sidebar-submenu__link">Blogs</a>
                </li>
              </ul>
              <!-- Submenu End -->
            </li>
            <li class="sidebar-menu__item">
              <a href="/admin-course" class="sidebar-menu__link">
                <span class="icon"><i class="ph ph-graduation-cap"></i></span>
                <span class="text">Courses</span>
              </a>
            </li>
            <li class="sidebar-menu__item">
              <a href="/admin/student/enroll" class="sidebar-menu__link">
