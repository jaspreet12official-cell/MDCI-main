<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Student Dashboard - My Profile</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gradient-to-br from-blue-50 to-white min-h-screen">
    <div class="flex flex-col md:flex-row min-h-screen">
      <!-- Sidebar -->
      <%- include("../partials/studentSidebar") %>

      <!-- Main Content -->
      <main class="flex-1 p-4 sm:p-6 md:p-10">
        <h1
          class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-800 mb-6 md:mb-8"
        >
          Welcome, <span class="text-blue-700"><%= student.name %></span> 🎓
        </h1>

        <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8">
          <div class="flex flex-col md:flex-row gap-8 items-start">
            <!-- Profile Image -->
            <div class="flex-shrink-0 w-full md:w-auto text-center">
              <img
                src="<%= student.imagePath || '/assets/default-profile.png' %>"
                alt="Student Photo"
                class="w-32 h-32 sm:w-36 sm:h-36 rounded-full object-cover border-4 border-blue-500 shadow"
              />
              <p class="mt-4 font-medium text-gray-700 text-base sm:text-lg">
                Reg No:
                <span class="font-semibold text-blue-600">
                  <%= student.regNo %>
                </span>
              </p>
            </div>

            <!-- Profile Info Grid -->
            <div class="flex-1 w-full">
              <h2
                class="text-xl sm:text-2xl font-semibold text-gray-800 mb-4 border-b pb-2"
              >
                Profile Information
              </h2>
              <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-700 text-sm sm:text-base"
              >
                <div><strong>Name:</strong> <%= student.name %></div>
                <div><strong>Email:</strong> <%= student.email %></div>
                <div>
                  <strong>DOB:</strong> <%= student.dob?.toDateString() || 'N/A'
                  %>
                </div>
                <div><strong>Gender:</strong> <%= student.gender %></div>
                <div>
                  <strong>Father's Name:</strong> <%= student.fatherName %>
                </div>
                <div>
                  <strong>Mother's Name:</strong> <%= student.motherName %>
                </div>
                <div>
                  <strong>Blood Group:</strong> <%= student.bloodGroup %>
                </div>
                <div><strong>Contact No:</strong> <%= student.contactNo %></div>
                <div>
                  <strong>Qualification:</strong> <%= student.qualification %>
                </div>
                <div><strong>Address:</strong> <%= student.address %></div>
                <div>
                  <strong>Marital Status:</strong> <%= student.maritalStatus %>
                </div>
                <div>
                  <strong>Occupation:</strong> <%= student.studentOccupation %>
                </div>
                <div>
                  <strong>Date of Admission:</strong> <%=
                  student.dateOfAdmission?.toDateString() || 'N/A' %>
                </div>
                <div>
                  <strong>Reference By:</strong> <%= student.referenceBy %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
