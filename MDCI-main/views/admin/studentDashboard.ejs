<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Student Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-100">
    <div class="min-h-screen flex flex-col md:flex-row">
      <!-- Sidebar -->
      <div
        class="md:w-64 w-full bg-white border-b md:border-b-0 md:border-r border-slate-200"
      >
        <%- include("../partials/studentSidebar") %>
      </div>

      <!-- Main Content -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8">
        <h1 class="text-2xl sm:text-3xl font-semibold mb-6 text-gray-800">
          Welcome, <%= student.name %> 🎉
        </h1>

        <!-- Info Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Email -->
          <div class="bg-white p-6 rounded-lg shadow">
            <div class="flex items-center mb-2">
              <svg
                class="w-5 h-5 text-blue-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 12H8m8 0l-4 4m4-4l-4-4M21 12c0 4.97-4.03 9-9 9S3 16.97 3 12 7.03 3 12 3s9 4.03 9 9z"
                />
              </svg>
              <h3 class="text-gray-700 font-bold">Email</h3>
            </div>
            <p class="text-gray-600"><%= student.email %></p>
          </div>

          <!-- Phone -->
          <div class="bg-white p-6 rounded-lg shadow">
            <div class="flex items-center mb-2">
              <svg
                class="w-5 h-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h1.28a2 2 0 011.94 1.5l.7 3.12a2 2 0 01-.45 1.85l-1.4 1.4a16 16 0 006.6 6.6l1.4-1.4a2 2 0 011.85-.45l3.12.7a2 2 0 011.5 1.94V19a2 2 0 01-2 2h-1c-9.94 0-18-8.06-18-18V5z"
                />
              </svg>
              <h3 class="text-gray-700 font-bold">Phone</h3>
            </div>
            <p class="text-gray-600"><%= student.contactNo %></p>
          </div>

          <!-- Course -->
          <div class="bg-white p-6 rounded-lg shadow">
            <div class="flex items-center mb-2">
              <svg
                class="w-5 h-5 text-purple-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 14l9-5-9-5-9 5 9 5z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 14l6.16-3.422A12.083 12.083 0 0112 21.5a12.083 12.083 0 01-6.16-10.922L12 14z"
                />
              </svg>
              <h3 class="text-gray-700 font-bold">Course Enrolled</h3>
            </div>
            <p class="text-gray-600">
              <%= student.course?.courseName || 'N/A' %>
            </p>
          </div>

          <!-- DOB -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-gray-700 font-bold">Date of Birth</h3>
            <p class="text-gray-600 mt-1">
              <%= student.dob ? new Date(student.dob).toDateString() : 'N/A' %>
            </p>
          </div>

          <!-- Address -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-gray-700 font-bold">Address</h3>
            <p class="text-gray-600 mt-1"><%= student.address %></p>
          </div>

          <!-- Enrollment Date -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-gray-700 font-bold">Enrollment Date</h3>
            <p class="text-gray-600 mt-1">
              <%= student.createdAt ? student.createdAt.toDateString() : 'N/A'
              %>
            </p>
          </div>

          <!-- Total Fees -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-gray-700 font-bold">Total Fees</h3>
            <p class="text-gray-600 mt-1">₹ <%= student.fees.totalFees %></p>
          </div>

          <!-- Amount Paid -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-gray-700 font-bold">Amount Paid</h3>
            <p class="text-gray-600 mt-1">₹ <%= student.fees.amountPaid %></p>
          </div>

          <!-- Dues -->
          <div class="bg-white p-6 rounded-lg shadow">
            <h3 class="text-gray-700 font-bold">Pending Dues</h3>
            <p class="text-gray-600 mt-1">₹ <%= student.fees.dues %></p>
          </div>
        </div>

        <!-- Future Widgets -->
        <div class="mt-10">
          <h2 class="text-xl font-semibold mb-4 text-gray-800">
            Upcoming Features
          </h2>
          <ul class="list-disc list-inside text-gray-600 space-y-1">
            <li>Course progress tracking</li>
            <li>Download certificate</li>
            <li>Assignment uploads</li>
          </ul>
        </div>
      </main>
    </div>
  </body>
</html>
