      <section class="colleges section_space">
        <div class="container">
          <div class="colleges_component">
            <div class="section_heading is_para"><%- ourCollegesContent %></div>
            <div class="row">
              <% universities.forEach(university => { %>
              <div class="col-md-6 col-lg-4">
                <div class="program_item colleges_item">
                  <!-- University Main Image -->
                  <div class="program_im-wrapper">
                    <img
                      src="<%= university.image %>"
                      class="w-100 h-100"
                      alt="<%= university.name %>"
                    />
                  </div>

                  <!-- Content Section -->
                  <div class="program_content">
                    <div class="clg_top">
                      <div class="row align-items-center">
                        <!-- University Logo -->
                        <div class="col-2">
                          <div class="clg_icon">
                            <img
                              src="<%= university.image %>"
                              class="w-100 h-100"
                              alt="Logo"
                            />
                          </div>
                        </div>

                        <!-- University Info -->
                        <div class="col-10">
                          <div class="program_middle p-0">
                            <h4 class="fw-bold"><%= university.name %></h4>

                            <!-- Rating -->
                            <div
                              class="program_rating d-flex align-items-center gap-2"
                            >
                              <p class="mb-0 text-primary">
                                <%= university.rating %>
                              </p>
                              <% const rating = parseFloat(university.rating) ||
                              0; const fullStars = Math.floor(rating); const
                              halfStar = rating % 1 >= 0.5; const emptyStars = 5
                              - fullStars - (halfStar ? 1 : 0); %>

                              <!-- Stars -->
                              <div class="d-flex align-items-center gap-1">
                                <% for (let i = 0; i < fullStars; i++) { %>
                                <i class="fas fa-star text-warning"></i>
                                <% } %> <% if (halfStar) { %>
                                <i
                                  class="fas fa-star-half-alt text-warning"
                                ></i>
                                <% } %> <% for (let i = 0; i < emptyStars; i++)
                                { %>
                                <i class="far fa-star text-warning"></i>
                                <% } %>
                              </div>
                            </div>

                            <!-- Enrolled + Location -->
                            <div
                              class="clg_contact d-flex align-items-center gap-3 mt-2"
                            >
                              <div
                                class="d-flex align-items-center gap-1 text-primary"
                              >
                                <i class="fas fa-book"></i>
                                <p class="mb-0">
                                  <%= university.enrolled %> Enrolled
                                </p>
                              </div>

                              <div
                                class="d-flex align-items-center gap-1 text-primary"
                              >
                                <i class="fas fa-map-marker-alt"></i>
                                <p class="mb-0"><%= university.location %></p>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- View Button -->
                  <div class="btn_grp text-center mt-3">
                    <a
                      href="<%= university.metaKeyword %>"
                      class="btn btn-primary btn-view"
                      >View College</a
                    >
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
        </div>
      </section>

