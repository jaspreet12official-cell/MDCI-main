    <script src="js/animation.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var toastEl = document.querySelector(".toast");
        if (toastEl) {
          var toast = new bootstrap.Toast(toastEl);
          toast.show();
        }
      });
    </script>
