<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #f8f9fa;
      text-align: center;
      padding: 60px;
      color: #333;
      height: 100vh;
    }
    .error-container {
      max-width: 600px;
      margin: auto;
    }
    h1 {
      font-size: 72px;
      margin-bottom: 0;
      color: #dc3545;
    }
    h2 {
      font-size: 24px;
      margin-top: 10px;
      color: #555;
    }
    p {
      margin-top: 30px;
      font-size: 16px;
    }
    a {
      display: inline-block;
      margin-top: 20px;
      text-decoration: none;
      color: #007bff;
    }
  </style>
</head>
<body>
  
  <div class="error-container">
    <h1><%= errorCode || 500 %></h1>
    <h2><%= errorMessage %></h2>
    <p>Oops! Something went wrong while loading <code><%= currentPath %></code>.</p>
    <a href="/">← Back to Home</a>
  </div>
   

</body>
</html>
