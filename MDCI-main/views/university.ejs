<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Desinerz Academy - Home</title>
    <meta name="description" content="" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta http-equiv="x-ua-compatible" content="IE=10" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/fontawesome/styles.min.css" />
    <link href="/css/fonts/fonts.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/custom.css" />
    <script type="text/javascript" src="js/jquery.min.js"></script>
    <script type="text/javascript" src="js/bootstrap.bundle.min.js"></script>
    <!-- page animation section css start -->
    <link rel="stylesheet" href="/css/animation.css" />
    <link rel="stylesheet" href="/css/aos.css" />
    <link rel="stylesheet" href="/css/w3.css" />
    <!-- page animation section css end -->
    <!-- cursor animated -->
    <link
      rel="stylesheet"
      type="text/css"
      media="screen"
      href="/css/cursor.css"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2//css/all.css"
    />
    <!-- cursor animated -->

    <!-- slick -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/swiper@8/swiper-bundle.min.css"
    />

    <script src="https://unpkg.com/swiper@8/swiper-bundle.min.js"></script>
    <!-- slick -->
  </head>

  <body id="body">
    <%- include("partials/header") %>
    <div class="page-wrapper" id="dashboard-page">
      <!-- main content -->
      <div class="main-wrapper">
        <div class="content-wrapper">
          <section class="bg_banner">
            <div class="container">
              <div class="bg_banner-text text-center">
                <p class="text-white">Chalo! Apna Career Bnaaye.</p>
                <h1 class="text-white">
                  Over 12,000+ students enrolled in the year of 2023-24
                </h1>
                <section class="is_breadcrumb">
                  <div class="container">
                    <ul
                      class="p-0 m-0 position-relative d-flex align-items-center justify-content-center"
                    >
                      <li>
                        <a href="/"
                          ><i
                            class="fa fa-home home_icon"
                            aria-hidden="true"
                          ></i>
                          Home</a
                        >
                      </li>

                      <?xml version="1.0" encoding="utf-8"?>
                      <!-- Uploaded to: SVG Repo, www.svgrepo.com, Generator: SVG Repo Mixer Tools -->
                      <svg
                        width="10px"
                        height="10px"
                        viewBox="0 0 1024 1024"
                        class="icon"
                        version="1.1"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M256 120.768L306.432 64 768 512l-461.568 448L256 903.232 659.072 512z"
                          fill="#fff"
                        />
                      </svg>
                      <li class="active">University / Colleges</li>
                    </ul>
                  </div>
                </section>
              </div>
            </div>
          </section>
          <section class="programs course_listing-pg is_clg">
            <div class="container">
              <div class="clg_listing">
                <div class="home_program-content">
                  <div class="row">
                    <% universities.forEach(university => { %>
                    <div class="col-md-6 col-lg-4">
                      <div class="program_item colleges_item">
                        <!-- University Main Image -->
                        <div class="program_im-wrapper">
                          <img
                            src="<%= university.image %>"
                            class="w-100 h-100"
                            alt="<%= university.name %>"
                          />
                        </div>

                        <!-- Content Section -->
                        <div class="program_content">
                          <div class="clg_top">
                            <div class="row align-items-center">
                              <!-- University Logo -->
                              <div class="col-2">
                                <div class="clg_icon">
                                  <img
                                    src="<%= university.image %>"
                                    class="w-100 h-100"
                                    alt="Logo"
                                  />
                                </div>
                              </div>

                              <!-- University Info -->
                              <div class="col-10">
                                <div class="program_middle p-0">
                                  <h4 class="fw-bold">
                                    <%= university.name %>
                                  </h4>

                                  <!-- Rating -->
                                  <div
                                    class="program_rating d-flex align-items-center gap-2"
                                  >
                                    <p class="mb-0 text-primary">
                                      <%= university.rating %>
                                    </p>
                                    <% const rating =
                                    parseFloat(university.rating) || 0; const
                                    fullStars = Math.floor(rating); const
                                    halfStar = rating % 1 >= 0.5; const
                                    emptyStars = 5 - fullStars - (halfStar ? 1 :
                                    0); %>

                                    <!-- Stars -->
                                    <div
                                      class="d-flex align-items-center gap-1"
                                    >
                                      <% for (let i = 0; i < fullStars; i++) {
                                      %>
                                      <i class="fas fa-star text-warning"></i>
                                      <% } %> <% if (halfStar) { %>
                                      <i
                                        class="fas fa-star-half-alt text-warning"
                                      ></i>
                                      <% } %> <% for (let i = 0; i < emptyStars;
                                      i++) { %>
                                      <i class="far fa-star text-warning"></i>
                                      <% } %>
                                    </div>
                                  </div>

                                  <!-- Enrolled + Location -->
                                  <div
                                    class="clg_contact d-flex align-items-center gap-3 mt-2"
                                  >
                                    <div
                                      class="d-flex align-items-center gap-1 text-primary"
                                    >
                                      <i class="fas fa-book"></i>
                                      <p class="mb-0">
                                        <%= university.enrolled %> Enrolled
                                      </p>
                                    </div>

                                    <div
                                      class="d-flex align-items-center gap-1 text-primary"
                                    >
                                      <i class="fas fa-map-marker-alt"></i>
                                      <p class="mb-0">
                                        <%= university.location %>
                                      </p>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <!-- About Content -->
                        <div class="clg-para mt-2">
                          <p class="text-muted">
                            <%- university.aboutContent %>
                          </p>
                        </div>

                        <!-- View Button -->
                        <div class="btn_grp text-center mt-3">
                          <a
                            href="<%= university.metaKeyword %>"
                            class="btn btn-primary btn-view"
                            >View College</a
                          >
                        </div>
                      </div>
                    </div>
                    <% }) %>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- main content -->

    <!-- footer section -->
        <%- include("partials/footer") %>


    <!-- slick -->

    <!-- slick -->

    <script>
      const swiper = new Swiper(".swiper", {
        // Optional parameters
        loop: true,
        centeredSlides: true,
        // Navigation arrows
        //   navigation: {
        //     nextEl: '.swiper-button-next',
        //     prevEl: '.swiper-button-prev',
        //   },
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        breakpoints: {
          // when window width is >= 320px
          768: {
            slidesPerView: 3,
            spaceBetween: 30,
          },
          // when window width is >= 480px
          1024: {
            slidesPerView: 3,
            spaceBetween: 40,
          },
          // when window width is >= 640px
          1280: {
            slidesPerView: 3,
            spaceBetween: 74,
          },
        },
      });
    </script>
    <script>
      var swiper2 = new Swiper(".swiper-container", {
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        parallax: true,
        speed: 600,
        breakpoints: {
          // when window width is >= 320px
          768: {
            slidesPerView: 1.1,
            spaceBetween: 16,
          },
          // when window width is >= 480px
          1024: {
            slidesPerView: 2,
            spaceBetween: 40,
          },
          // when window width is >= 640px
          1280: {
            slidesPerView: 2,
            spaceBetween: 29,
          },
        },
      });
    </script>

    <script type="text/javascript" src="js/custom.js"></script>
    <script src="js/cursor.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/js/intlTelInput-jquery.min.js"></script>
    <script type="text/javascript" src="js/custom.js"></script>
    <!-- page animation section js start -->
    <script type="text/javascript" src="js/animation.js"></script>

    <!-- page animation section js end -->
  </body>
</html>
